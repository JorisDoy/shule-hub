# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Keycloak realm URL (OIDC issuer). The app discovers endpoints from
# ${NEXT_PUBLIC_OIDC_AUTHORITY}/.well-known/openid-configuration
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8180/realms/shulehub

# Public client (no secret) with Standard Flow + PKCE (S256) enabled.
# Valid redirect URIs must include <origin>/app ; post-logout redirect <origin>/ ; web origins <origin>
NEXT_PUBLIC_OIDC_CLIENT_ID=shulehub-web

# Spring Boot backend. Server-side only: Next.js rewrites /api/:path* to ${BACKEND_URL}/api/:path*
# Read when `next build` / `next dev` starts (rewrites are fixed at build time for `next start`).
BACKEND_URL=http://localhost:8080

# Optional: public URL of the marketing site, used for canonical links, sitemap.xml and Open Graph.
NEXT_PUBLIC_SITE_URL=https://shulehub.example
